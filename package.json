{
  "name": "resolvehq",
  "version": "0.3.4",
  "private": true,
  "description": "Self-hosted helpdesk on Cloudflare Workers: D1, R2, Queues, Email Routing. Shared inbox, email threading, AI assist.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirza-rizvi/ResolveHQ.git"
  },
  "homepage": "https://github.com/mirza-rizvi/ResolveHQ#readme",
  "bugs": {
    "url": "https://github.com/mirza-rizvi/ResolveHQ/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "helpdesk",
    "customer-support",
    "shared-inbox",
    "self-hosted",
    "cloudflare-workers",
    "cloudflare-d1",
    "cloudflare-r2",
    "cloudflare-queues",
    "email-routing",
    "workers-ai",
    "hono",
    "react"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "deploy": "npm run cloudflare:check && npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"e2e/**/*.ts\"",
    "test": "vitest run",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:e2e": "npm run db:reset:local && playwright test --project=chromium",
    "screenshots": "npm run db:reset:local && playwright test --project=screenshots",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=drizzle/seed.sql",
    "db:reset:local": "bash scripts/db-reset-local.sh",
    "cloudflare:check": "node scripts/cloudflare-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "auth:benchmark": "node scripts/auth-benchmark.mjs"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.3",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.57.0",
    "postal-mime": "^2.7.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "miniflare": {
      "undici": "7.30.0"
    }
  }
}
