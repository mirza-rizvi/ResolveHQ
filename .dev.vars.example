# Production-safe defaults, also used by Deploy to Cloudflare prompts.
# Required: generate a unique value with openssl rand -hex 32. Never rotate casually.
SESSION_PEPPER=replace-with-at-least-32-random-characters
DEV_MAIL_MODE=disabled
