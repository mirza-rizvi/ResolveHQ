# Production-safe defaults, also used by Deploy to Cloudflare prompts.
# Required: generate a unique value with openssl rand -hex 32. Never rotate casually.
SESSION_PEPPER=replace-with-at-least-32-random-characters
DEV_MAIL_MODE=disabled
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...
# SYSTEM_MAIL_FROM=no-reply@example.com
# Signed plus-address Reply-To on outbound mail. Needs an Email Routing catch-all
# rule for the sending domain, otherwise tagged replies never reach the Worker.
# OUTBOUND_REPLY_TOKEN=enabled
# APP_URL=https://your-worker.example.com
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AUTH_TIMING_SAMPLE_RATE=0
# TURNSTILE_SITE_KEY=0x...
# TURNSTILE_SECRET_KEY=0x...
