{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resolvehq",
  "main": "worker.ts",
  "alias": {
    "resolve-server/activity/service": "./src/server/activity/service.ts",
    "resolve-server/app": "./src/server/app.ts",
    "resolve-server/auth/middleware": "./src/server/auth/middleware.ts",
    "resolve-server/auth/password": "./src/server/auth/password.ts",
    "resolve-server/db": "./src/server/db/index.ts",
    "resolve-server/db/schema": "./src/server/db/schema.ts",
    "resolve-server/http/errors": "./src/server/http/errors.ts",
    "resolve-server/lib/crypto": "./src/server/lib/crypto.ts",
    "resolve-server/lib/id": "./src/server/lib/id.ts",
    "resolve-server/providers/storage": "./src/server/providers/storage.ts",
    "resolve-server/types": "./src/server/types.ts",
    "resolve-shared/domain": "./src/shared/domain.ts"
  },
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resolvehq",
      "database_id": "replace-with-production-d1-id",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "resolvehq-attachments" }
  ],
  "queues": {
    "producers": [
      { "binding": "INBOUND_MAIL_QUEUE", "queue": "resolvehq-inbound-mail" },
      { "binding": "OUTBOUND_MAIL_QUEUE", "queue": "resolvehq-outbound-mail" }
    ],
    "consumers": [
      { "queue": "resolvehq-inbound-mail", "max_batch_size": 5, "max_retries": 5, "dead_letter_queue": "resolvehq-inbound-mail-dlq" },
      { "queue": "resolvehq-outbound-mail", "max_batch_size": 5, "max_retries": 5, "dead_letter_queue": "resolvehq-outbound-mail-dlq" }
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "APP_URL": "http://localhost:5173", "DEV_MAIL_MODE": "capture" }
}
